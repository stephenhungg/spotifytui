# Spotify API (required)
# Get credentials: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_client_id
SPOTIPY_CLIENT_SECRET=your_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Genius API (optional - for lyrics)
# Get token: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_token

# VibeChain API (optional - for AI recommendations)
# VIBECHAIN_API_URL=http://localhost:8080
# VIBECHAIN_API_PATH=/path/to/playlistify-api
